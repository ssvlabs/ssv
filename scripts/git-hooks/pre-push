#!/bin/sh
# Pre-push hook: lint what this push introduces or modifies, so lint failures
# surface locally instead of on the PR's lint check. Two stages:
#
#   1. misspell (-locale US, mirroring .golangci.yaml's misspell locale) on the
#      changed .go/.md blobs at the pushed commit. Only the locale is mirrored:
#      .golangci.yaml's misspell.ignore-rules aren't forwarded, so pass any real
#      entry there to misspell's -i flag here too. Generated .go files are
#      skipped, mirroring .golangci.yaml's exclusions.generated. CI's `make
#      lint` lints only .go, and not the nested scripts/differ module, so
#      findings in either are this hook's own check rather than a CI gate.
#   2. golangci-lint (the same config CI's `make lint` uses) on the packages
#      containing changed .go files. Unlike misspell it needs full packages on
#      disk for type-checking, so it lints the checkout rather than the pushed
#      blobs and only runs when pushing the checked-out HEAD.
#
# Install with: make install-hooks
# Bypass for a one-off push: git push --no-verify

root=$(git rev-parse --show-toplevel) || exit 0

# go tool compiles the linters from tool.mod on first use and caches them; go
# may not be on PATH in GUI-spawned shells, so fall back to the default install.
if command -v go >/dev/null 2>&1; then
	GO=go
elif [ -x /usr/local/go/bin/go ]; then
	GO=/usr/local/go/bin/go
elif [ -x /opt/homebrew/bin/go ]; then # Homebrew on Apple Silicon
	GO=/opt/homebrew/bin/go
else
	exit 0
fi

# Mirrors .golangci.yaml's exclusions.generated: lax, so the spelling stage
# doesn't report what CI ignores. golangci parses the file with
# PackageClauseOnly|ParseComments and matches these four markers
# case-insensitively against the comments above the package clause — not the
# stricter "^// Code generated .* DO NOT EDIT\.$" line — so match the same four
# over everything ahead of the clause, which in practice is comments and build
# tags. Reads the blob on stdin.
is_generated_go() {
	awk '
		tolower($0) ~ /code generated|do not edit|autogenerated file|\* generated by: swagger codegen / {
			found = 1
			exit
		}
		/^[[:space:]]*package[[:space:]]/ { exit }
		END { exit !found }
	'
}

ZERO=0000000000000000000000000000000000000000
status=0
ci_findings=0    # findings CI's `make lint` would fail on too
docs_findings=0  # .md spelling — blocks locally, but CI doesn't lint .md
nonci_findings=0 # .go spelling in a module `make lint` doesn't reach

# Changed paths may contain spaces or glob characters: iterate $files with a
# newline-only IFS (restored to the default around the outer read, which needs
# it to split its fields) and keep pathname expansion off for the whole run.
set -f
nl='
'
oIFS=$IFS
head_sha=$(git rev-parse HEAD)
lint_dirs=""
ssvsigner_lint_dirs=""
misspell_ok="" # probed lazily on the first push with changed files

while read -r local_ref local_sha remote_ref remote_sha; do
	[ "$local_sha" = "$ZERO" ] && continue # deleting a remote ref

	# Diff base: the newest commit this push doesn't own. git diff compares two
	# trees, so any sideways move of the branch leaks base-branch files into the
	# diff — slow for golangci, and (since CI doesn't lint .md) able to block the
	# push on a doc typo nobody here wrote. The remote tip is the tightest base
	# for a plain incremental push, but not after a rebase + force-push (it isn't
	# our ancestor) or after merging the base branch in (it sits behind the new
	# fork point), so take it only while it's both behind us and ahead of the
	# fork, else fall back to the merge-base with stage (or main).
	fork=$(git merge-base "$local_sha" origin/stage 2>/dev/null) ||
		fork=$(git merge-base "$local_sha" origin/main 2>/dev/null) ||
		fork=""
	base=$fork
	if [ "$remote_sha" != "$ZERO" ] &&
		git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null &&
		{ [ -z "$fork" ] || git merge-base --is-ancestor "$fork" "$remote_sha" 2>/dev/null; }; then
		base=$remote_sha
	fi
	if [ -z "$base" ]; then
		echo "pre-push: no merge-base with origin/stage or origin/main — skipping lint for $local_ref" >&2
		continue
	fi

	# quotePath=off: git C-quotes non-ASCII paths by default ("\346\226\207.go"),
	# and the quoted name resolves neither as a git path nor as a directory, so
	# both stages would silently skip the file.
	files=$(git -c core.quotePath=off diff --name-only --diff-filter=ACMR "$base" "$local_sha" -- '*.go' '*.md')
	[ -z "$files" ] && continue

	# go tool failures (resolution, compile, module download) must not be
	# mistaken for spelling findings, so probe misspell once up front; if it
	# can't run, warn and skip this stage instead of blocking the push.
	if [ -z "$misspell_ok" ]; then
		if printf '' | GOWORK=off "$GO" tool -modfile="$root/tool.mod" misspell -locale US -error >/dev/null 2>&1; then
			misspell_ok=y
		else
			misspell_ok=n
			echo "pre-push: cannot run misspell via 'go tool' — skipping the spelling stage" >&2
		fi
	fi

	# Check the blobs at local_sha, not the working tree, so uncommitted edits
	# don't mask (or fake) findings in what's actually being pushed.
	if [ "$misspell_ok" = y ]; then
		IFS=$nl
		for f in $files; do
			# CI's misspell runs through golangci-lint, which excludes
			# generated files; scanning them here would block a push on
			# output the author can't hand-fix while CI stays green.
			case $f in
			*.go)
				if git show "$local_sha:$f" 2>/dev/null | is_generated_go; then
					continue
				fi
				;;
			esac
			out=$(git show "$local_sha:$f" 2>/dev/null |
				GOWORK=off "$GO" tool -modfile="$root/tool.mod" misspell -locale US -error 2>&1)
			if [ -n "$out" ]; then
				echo "pre-push: misspell found issues in $f:" >&2
				# misspell reads stdin, so it reports the path as "stdin";
				# swap in the real one with printf rather than sed, so a
				# path holding |, & or \ can't corrupt the substitution.
				echo "$out" | while IFS= read -r line; do
					case $line in
					stdin*) printf '  %s%s\n' "$f" "${line#stdin}" ;;
					*) printf '%s\n' "$line" ;;
					esac
				done >&2
				status=1
				# Blocking either way, but only some of it is a
				# CI front-run: `make lint` lints neither .md nor
				# the nested scripts/differ module (the golangci
				# stage skips it for the same reason).
				case $f in
				*.md) docs_findings=1 ;;
				scripts/differ/*) nonci_findings=1 ;;
				*) ci_findings=1 ;;
				esac
			fi
		done
		IFS=$oIFS
	fi

	# Collect the packages holding changed .go files for the golangci-lint
	# stage. Only when this ref is the checked-out HEAD — the checkout is what
	# gets linted, so for any other ref the results wouldn't describe the push.
	[ "$local_sha" = "$head_sha" ] || continue
	IFS=$nl
	for f in $files; do
		case $f in
		*.go) ;;
		*) continue ;;
		esac
		d=./$(dirname "$f")
		[ -d "$root/${d#./}" ] || continue # dir may be gone (renames)
		case $d in
		# ssvsigner is a nested module CI lints too (make lint runs
		# ssvsigner-golangci-lint from ssvsigner/), and its packages can't be
		# loaded from the root, so collect its dirs for a separate run.
		./ssvsigner | ./ssvsigner/*)
			sd=.${d#./ssvsigner}
			case " $ssvsigner_lint_dirs " in
			*" $sd "*) ;;
			*) ssvsigner_lint_dirs="$ssvsigner_lint_dirs $sd" ;;
			esac
			continue
			;;
		# Nested module CI's `make lint` doesn't cover.
		./scripts/differ | ./scripts/differ/*) continue ;;
		esac
		case " $lint_dirs " in
		*" $d "*) ;;
		*) lint_dirs="$lint_dirs $d" ;;
		esac
	done
	IFS=$oIFS
done

# Run golangci-lint from $1, with the config in $2 (empty to let it discover
# the config from $1) over the dirs in the remaining args.
golangci_run() {
	gr_wd=$1
	gr_cfg=$2
	shift 2
	[ -n "$gr_cfg" ] && set -- -c "$gr_cfg" "$@"
	(cd "$gr_wd" && GOWORK=off "$GO" tool -modfile="$root/tool.mod" golangci-lint run "$@" >&2)
}

# Fold one golangci-lint exit code into the push decision, blocking only on real
# findings: it exits 1 for those, and anything else (3 config or run failure, 4
# timeout, ...) is an execution problem this hook shouldn't gate on. Exit 5 is
# "no go files to analyze" — nothing to report for that dir.
classify_golangci() {
	case $1 in
	0 | 5) ;;
	1)
		status=1
		ci_findings=1
		;;
	*) echo "pre-push: golangci-lint failed to run in $2 (exit $1) — skipping its findings" >&2 ;;
	esac
}

# Lint the dirs in one batched run, which is what keeps the stage at seconds.
# One dir with no analyzable Go files (everything under a testdata/ dir, or all
# excluded by build tags) fails the whole invocation with exit 5, though, which
# would drop every other dir's findings with it — so on a 5, fall back to a run
# per dir and pay the extra seconds only in that case.
run_golangci() {
	rg_wd=$1
	rg_cfg=$2
	shift 2
	rg_rc=0
	golangci_run "$rg_wd" "$rg_cfg" "$@" || rg_rc=$?
	if [ "$rg_rc" -eq 5 ] && [ $# -gt 1 ]; then
		echo "pre-push: a linted dir has no analyzable Go files — retrying one dir at a time" >&2
		for rg_dir in "$@"; do
			rg_rc=0
			golangci_run "$rg_wd" "$rg_cfg" "$rg_dir" || rg_rc=$?
			classify_golangci "$rg_rc" "$rg_wd"
		done
		return
	fi
	classify_golangci "$rg_rc" "$rg_wd"
}

# golangci-lint stage: staticcheck & friends on the changed packages, scoped so
# a push costs seconds, not CI's full-repo minutes. It sees the working tree,
# so uncommitted edits in these packages show up here.
#
# As with misspell, a go tool failure (resolution, compile, module download)
# exits 1 exactly like real findings do, so probe once before trusting any exit
# code; if the tool can't run at all, warn and skip instead of blocking.
if [ -n "$lint_dirs" ] || [ -n "$ssvsigner_lint_dirs" ]; then
	if GOWORK=off "$GO" tool -modfile="$root/tool.mod" golangci-lint version >/dev/null 2>&1; then
		if [ -n "$lint_dirs" ]; then
			# shellcheck disable=SC2086 # lint_dirs is word-split on purpose
			run_golangci "$root" "" $lint_dirs
		fi
		if [ -n "$ssvsigner_lint_dirs" ]; then
			# Mirrors make lint's ssvsigner-golangci-lint: the nested module is
			# linted from its own directory, with the root's config and tool.mod.
			# shellcheck disable=SC2086 # ssvsigner_lint_dirs is word-split on purpose
			run_golangci "$root/ssvsigner" "$root/.golangci.yaml" $ssvsigner_lint_dirs
		fi
	else
		echo "pre-push: cannot run golangci-lint via 'go tool' — skipping the lint stage" >&2
	fi
fi

if [ "$status" -ne 0 ]; then
	echo "" >&2
	if [ "$ci_findings" -ne 0 ]; then
		echo "pre-push: fix the issues above and amend/commit — the CI lint check (make lint) fails on them." >&2
	fi
	if [ "$docs_findings" -ne 0 ]; then
		echo "pre-push: the .md spelling above is this hook's own check — CI's make lint doesn't lint .md." >&2
	fi
	if [ "$nonci_findings" -ne 0 ]; then
		echo "pre-push: the scripts/differ spelling above is this hook's own check — make lint doesn't lint that nested module." >&2
	fi
	echo "pre-push: bypass once with: git push --no-verify" >&2
fi
exit $status
